{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/(img|uploads|templates)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(manifest\\.json|service-worker\\.js|favicon\\.ico)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
